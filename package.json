{
  "name": "forma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Forma — Train. Track. Transform.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "import:sheet": "node --experimental-strip-types scripts/importSheet.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "mongo:init-indexes": "node scripts/mongo-init-indexes.mjs",
    "mongo:seed-admin": "node scripts/seed-mongo-admin.mjs",
    "mongo:seed-demo": "node scripts/seed-mongo-demo.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@tanstack/react-query": "^5.101.0",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "google-auth-library": "^11.1.0",
    "i18next": "^24.2.0",
    "jsonwebtoken": "^9.0.2",
    "localforage": "^1.10.0",
    "mongodb": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.28.0",
    "resend": "^6.28.1",
    "three": "^0.169.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.48.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vercel/node": "^3.2.24",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.2",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.0"
  }
}
